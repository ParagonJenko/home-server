# Copy to proxmox.env (gitignored) and fill. chmod 600. Never commit the real one.
PROXMOX_HOST=192.168.1.2            # NUC-1 (NUC-2 gets its own env file: 192.168.1.3)
PROXMOX_PORT=8006
PROXMOX_TOKEN_ID=claude@pve!automation
PROXMOX_TOKEN_SECRET=PASTE_THE_SECRET_SHOWN_ONCE_BY_STAGE_A
PROXMOX_VERIFY_SSL=false            # self-signed cert on the LAN; "true" or a CA path if you have one
PROXMOX_READONLY=false             # "true" to refuse all power/snapshot writes
