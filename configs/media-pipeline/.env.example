# media-pipeline/.env — COPY to .env (gitignored) and fill. NEVER commit real values.
# Shared by arr-setup.py, Recyclarr, Decluttarr and qbit_manage.
# The API keys don't exist until Sonarr/Radarr/Prowlarr have booted once — fill them
# in phase 2 (grab each from Settings -> General -> API Key, or read config.xml).
TZ=Europe/London
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
# qBittorrent WebUI login. User is 'admin'; set a permanent password in the WebUI first
# (its first-boot temporary password is printed in `docker logs qbittorrent`).
QBIT_USER=admin
QBIT_PASS=
# (Decluttarr's dry-run switch lives in decluttarr.config.yaml as test_run, not here.)
# Optional: Arr "Minimum Free Space When Importing" in MB (arr-setup.py, default 10240).
# ARR_MIN_FREE_MB=10240

# --- maintainerr-keeper (Discord Keep/Delete bot) — set via gather-keeper-creds.sh, don't hand-edit ---
# DISCORD_BOT_TOKEN=            # Bot token (Discord dev portal -> your app -> Bot -> Reset Token)
# DISCORD_CHANNEL_ID=          # numeric channel id (Developer Mode -> right-click channel -> Copy ID)
# DRY_RUN=1                    # 1 = buttons only log; set 0 once you've watched it work
# SELFTEST=1                   # posts a dummy card with test buttons on boot to prove clicks work; set 0 after
# The bot reuses RADARR_API_KEY / SONARR_API_KEY above for the Delete action.
