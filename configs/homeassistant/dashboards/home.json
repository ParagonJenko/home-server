{
  "title": "Home",
  "views": [
    {
      "title": "Home",
      "path": "home",
      "icon": "mdi:home-heart",
      "type": "sections",
      "max_columns": 3,
      "header": {
        "layout": "responsive",
        "badges_position": "bottom",
        "card": {
          "type": "markdown",
          "text_only": true,
          "content": "{% set h = now().hour %}{% if h < 5 %}Still up?{% elif h < 12 %}Good morning{% elif h < 18 %}Good afternoon{% elif h < 22 %}Good evening{% else %}Good night{% endif %}, Alex\n# {% set h = now().hour %}{% if h < 5 %}🌙 Still up?{% elif h < 12 %}☀️ Good morning{% elif h < 18 %}🌤️ Good afternoon{% elif h < 22 %}🌆 Good evening{% else %}🌙 Good night{% endif %}\n### {{ now().strftime('%A %-d %B') }} · {{ states('weather.home') | replace('-',' ') | title }} · {{ state_attr('weather.home','temperature') | round(0) }}°"
        }
      },
      "badges": [
        {
          "type": "entity",
          "entity": "person.alex_jenkinson",
          "show_name": true,
          "color": "green"
        },
        {
          "type": "entity",
          "entity": "sensor.alexs_iphone_battery_level",
          "show_name": false,
          "name": "Phone"
        },
        {
          "type": "entity",
          "entity": "sensor.hue_motion_sensor_temperature",
          "name": "Office",
          "color": "amber"
        },
        {
          "type": "entity",
          "entity": "sun.sun",
          "name": "Sun"
        }
      ],
      "sections": [
        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "At a glance",
              "icon": "mdi:eye"
            },
            {
              "type": "weather-forecast",
              "entity": "weather.home",
              "forecast_type": "daily",
              "show_current": true,
              "grid_options": {
                "columns": "full"
              }
            },
            {
              "type": "custom:mushroom-chips-card",
              "alignment": "center",
              "chips": [
                {
                  "type": "template",
                  "entity": "person.alex_jenkinson",
                  "icon": "mdi:map-marker-radius",
                  "icon_color": "{{ 'green' if is_state('person.alex_jenkinson','home') else 'blue-grey' }}",
                  "content": "{{ states('person.alex_jenkinson') | title }}",
                  "tap_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "template",
                  "entity": "sensor.alexs_iphone_battery_level",
                  "icon": "mdi:cellphone",
                  "icon_color": "{{ 'red' if states('sensor.alexs_iphone_battery_level')|int(100) < 20 else 'green' }}",
                  "content": "{{ states('sensor.alexs_iphone_battery_level') }}%"
                },
                {
                  "type": "template",
                  "entity": "sensor.hue_motion_sensor_temperature",
                  "icon": "mdi:thermometer",
                  "icon_color": "amber",
                  "content": "{{ states('sensor.hue_motion_sensor_temperature') }}°"
                },
                {
                  "type": "weather",
                  "entity": "weather.home",
                  "show_conditions": true,
                  "show_temperature": true
                }
              ],
              "grid_options": {
                "columns": "full"
              }
            }
          ]
        },
        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "Jump to",
              "icon": "mdi:gesture-tap-button"
            },
            {
              "type": "custom:mushroom-template-card",
              "primary": "Lights",
              "secondary": "{{ states.light | selectattr('state','eq','on') | list | count }} on",
              "icon": "mdi:lightbulb-group",
              "icon_color": "amber",
              "tap_action": {
                "action": "navigate",
                "navigation_path": "/dashboard-home/lights"
