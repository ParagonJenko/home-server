# configs/social-generator/.env — copy this to .env (gitignored) and fill in. Pushed to
# /opt/social-generator/deploy/.env in LXC 250 by configs/lxc/social-generator.sh.
# Same keys as the project's deploy/.env.example.

# The Social posts sheet's ID: the long part of its URL between /d/ and /edit.
SHEET_ID=

# Tab to read.
SHEET_TAB=Social posts

# Set to 0 to stop the tool filling in "Assets made".
SHEET_WRITE_BACK=1

# Only if NOT using a service account: a "Publish to web" CSV link. Leave SHEET_ID empty then.
SHEET_CSV_URL=

# How often to look at the sheet, and which port the review page is on (nginx proxies to it).
CHECK_EVERY_MINUTES=60
REVIEW_PORT=8087
