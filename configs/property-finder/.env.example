# configs/property-finder/.env — copy to .env (gitignored) only if you need to change these.
# Pushed to /opt/local-property-finder/.env in LXC 260 by configs/lxc/property-finder.sh.
# Areas, tiers and webhooks are NOT here — they live in config.yaml (see README.md).

NODE_ENV=production
DATA_DIR=/opt/local-property-finder/data
SCRAPER_INTERVAL_HOURS=6
LOG_LEVEL=info

# Must match the front name nginx serves it on, or the browser's API calls are refused.
CORS_ORIGIN=https://property.home.alexjenkinson.com

VITE_ENABLE_BUY_LISTINGS=false

# Separate Discord channel for DB health summaries (secret — fill only in .env, never here).
# HEALTH_CHECK_WEBHOOK_URL=
