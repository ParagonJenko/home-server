# configs/cloudflared/.env — gitignored, set on-box (boxes pull only, R21). The tunnel exposes
# ONLY this target (the HA-MCP server), never HA's login UI.
#
# HA_MCP_URL: the HA-MCP "local network access" endpoint host:port. Enable it in HA →
# HA-MCP integration → Configure → local network access. Default = HA VM 910 at :9584.
HA_MCP_URL=http://192.168.1.25:9584
#
# CLOUDFLARED_TUNNEL_TOKEN: leave BLANK for a QUICK tunnel (instant https://<random>.trycloudflare.com,
# which changes on every restart — fine for testing). For a STABLE hostname, create a tunnel in
# Cloudflare Zero Trust (Networks → Tunnels), route a public hostname to HA_MCP_URL, and paste its
# token here; named mode then ignores the quick-tunnel URL.
CLOUDFLARED_TUNNEL_TOKEN=
