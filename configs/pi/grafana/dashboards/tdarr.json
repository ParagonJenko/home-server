{
  "uid": "tdarr",
  "title": "Tdarr transcoding",
  "tags": ["homelab", "media"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "🎞️ Tdarr", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "id": 2, "type": "stat", "title": "Space saved (lifetime)",
      "description": "Cumulative size difference from transcoding. Positive = space reclaimed; negative = net larger. From tdarr_size_diff_bytes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "decbytes", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(tdarr_size_diff_bytes)" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Transcodes completed",
      "description": "Lifetime count of files transcoded (global gauge — can drop when files are purged).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "sum(tdarr_transcodes_completed)" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Files in libraries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "sum(tdarr_files)" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Health check score",
      "description": "Share of the library passing health checks (tdarr_health_check_score_ratio, 0–1).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "max(tdarr_health_check_score_ratio)" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Transcodes completed over time",
      "description": "Watch this climb as Tdarr works through the queue.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "expr": "sum(tdarr_transcodes_completed)", "legendFormat": "transcoded" } ]
    },
    {
      "id": 7, "type": "bargauge", "title": "Files by transcode state",
      "description": "Current snapshot per state (queued / transcoded / errored / ignored …) from tdarr_library_transcodes. 'Queued' is the backlog; watch 'error' states.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum by (status) (tdarr_library_transcodes)", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 8, "type": "table", "title": "Per-library",
      "description": "Files, space saved and transcodes per library.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [ { "matcher": { "id": "byName", "options": "Space saved" }, "properties": [ { "id": "unit", "value": "decbytes" } ] } ] },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "expr": "sum by (library_name) (tdarr_library_files)", "format": "table", "instant": true },
        { "refId": "B", "expr": "sum by (library_name) (tdarr_library_size_diff_bytes)", "format": "table", "instant": true },
        { "refId": "C", "expr": "sum by (library_name) (tdarr_library_transcodes_completed_total)", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge" },
        { "id": "organize", "options": { "renameByName": { "library_name": "Library", "Value #A": "Files", "Value #B": "Space saved", "Value #C": "Transcoded" }, "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true } } }
      ]
    },
    {
      "id": 9, "type": "stat", "title": "Active transcode workers",
      "description": "How many workers Tdarr is running right now (node worker series present).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "count(tdarr_node_worker_info) or vector(0)" } ]
    },
    {
      "id": 10, "type": "stat", "title": "Exporter up",
      "description": "0 = the Tdarr exporter or Tdarr itself is unreachable.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "up{job=\"tdarr-stats\"}" } ]
    },
    {
      "id": 11, "type": "stat", "title": "Tdarr server uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "max(tdarr_server_uptime_seconds)" } ]
    }
  ]
}
