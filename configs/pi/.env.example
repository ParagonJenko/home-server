# pi/.env — COPY to .env (gitignored, chmod 600). NEVER commit real values. [R21]
# Holds every Pi-stack secret: the Grafana password and all application-exporter credentials.
# After editing, re-run the exporter: cd /opt/pi-stack && docker compose up -d

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=

# --- Proxmox pve-exporter (per-guest metrics) ---
# Create a read-only monitoring token on a NUC (either node — the token is cluster-wide):
#   pveum user token add claude@pve monitoring --privsep 0
#   pveum acl modify / --roles PVEAuditor --tokens 'claude@pve!monitoring'
# then paste the token's value (shown once) below.
PVE_USER=claude@pve
PVE_TOKEN_NAME=monitoring
PVE_TOKEN_VALUE=
PVE_VERIFY_SSL=false

# --- Media stack ---
# Plex token: open any item in the Plex web app → ⋯ → Get Info → View XML; the token is the
# X-Plex-Token=... at the end of the URL.
PLEX_TOKEN=
# qBittorrent WebUI login (media-pipeline:8080).
QBIT_USER=
QBIT_PASS=
# Arr API keys — each app → Settings → General → API Key.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# --- PBS backup exporter ---
# Create a read-only token on the PBS VM:
#   proxmox-backup-manager user generate-token root@pam monitoring
#   proxmox-backup-manager acl update / Audit --auth-id 'root@pam!monitoring'
# then paste the token value (shown once) below.
PBS_TOKEN_NAME=monitoring
PBS_TOKEN_VALUE=

# --- AdGuard exporter ---
# The AdGuard admin login (the one you set in the AdGuard setup wizard, :8081).
ADGUARD_USER=
ADGUARD_PASS=

# --- Home Assistant ---
# Enable the Prometheus integration in HA (configs/homeassistant/prometheus-snippet.yaml), then make a
# Long-Lived Access Token: HA → your profile (bottom-left) → Security → Long-lived access tokens → Create.
HA_TOKEN=

# --- Tdarr ---
# Tdarr's API key — its /api/v2/cruddb (stats/library) endpoint returns 401 without it, so the
# tdarr-exporter needs it even though the UI has no login. Read it from the server config:
#   pct exec 210 -- grep -oE '"apiKey":"[^"]*"' /opt/tdarr/configs/Tdarr_Server_Config.json
TDARR_API_KEY=
