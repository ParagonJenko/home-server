# pi/.env — COPY to .env (gitignored, chmod 600). NEVER commit real values. [R21]
# Holds every Pi-stack secret: the Grafana password and all application-exporter credentials.
# After editing, re-run the exporter: cd /opt/pi-stack && docker compose up -d

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=

# --- Proxmox pve-exporter (per-guest metrics) ---
# Create a read-only monitoring token on a NUC (either node — the token is cluster-wide):
#   pveum user token add claude@pve monitoring --privsep 0
#   pveum acl modify / --roles PVEAuditor --tokens 'claude@pve!monitoring'
# then paste the token's value (shown once) below.
PVE_USER=claude@pve
PVE_TOKEN_NAME=monitoring
PVE_TOKEN_VALUE=
PVE_VERIFY_SSL=false
