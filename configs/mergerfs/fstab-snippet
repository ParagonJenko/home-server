# mergerfs/fstab-snippet — the media pool. Add to /etc/fstab on NUC-1. [R8 R9]
#
# Two branches unioned into /mnt/media. Key options:
#   minfreespace=250G   reserved headroom — new files refuse once a branch is this full (R8)
#   category.create=epmfs (or mfs)  keep a path's files on ONE branch so hardlinks work (R1/E1)
#                        NB: the base dirs (torrents/, library/) must exist on EVERY branch, or
#                        a split across disks makes hardlinks fail with EXDEV. stage-b creates
#                        them per-branch for exactly this reason.
#   x-systemd.requires=  the pool REFUSES to mount if a branch is missing, instead of
#                        silently unioning from the host root device (R9)
#   nofail (pool+branch) boot still comes up if a DAS disk is missing — branch + pool fail
#                        gracefully (branches also x-systemd.device-timeout=30s) instead of
#                        hanging / dropping to emergency. Pairs with requires= so a missing disk
#                        = pool just doesn't mount (media down), never a host-SSD union (R9).
#
# /mnt/pool/disk1:/mnt/pool/disk2  /mnt/media  fuse.mergerfs  \
#   defaults,allow_other,use_ino,cache.files=partial,dropcacheonclose=true,\
#   category.create=epmfs,minfreespace=250G,fsname=mergerfs,\
#   x-systemd.requires=/mnt/pool/disk1,x-systemd.requires=/mnt/pool/disk2,nofail  0 0
#
# ENTER: tune minfreespace to match storage.md (branch paths are fixed: /mnt/pool/disk1,2).
# Note: stage-b-storage.sh already writes this exact line to /etc/fstab — this snippet is the reference.
